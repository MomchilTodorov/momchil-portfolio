# Development uses the bundled local WordPress CMS through a same-origin API bridge.
VITE_WP_API_BASE=/api/

# For an existing or production WordPress CMS, use its PUBLIC REST API base:
# VITE_WP_API_BASE=https://cms.example.com/wp-json/
# No WordPress password or API key belongs in a VITE_ variable.

# Only used to generate canonical tags during a production build.
# PUBLIC_SITE_URL=https://your-portfolio.example
